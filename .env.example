# Zkopíruj do .env a doplň. Soubor .env se necommituje (repozitář je veřejný).

# Generativní LLM přes OpenAI-kompatibilní API (ADR-0008)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=

# Router Jev (ADR-0004)
TYPESAFE_API_KEY=

# Langfuse — prompty a trasování (ADR-0009); prázdné = trasování vypnuto
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
